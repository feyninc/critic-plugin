{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/bin/critic.mjs\" hook session-start --provider codex",
            "timeout": 10,
            "statusMessage": "Connecting this task to Critic"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/bin/critic.mjs\" hook user-prompt-submit --provider codex",
            "timeout": 5,
            "statusMessage": "Updating Critic"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|apply_patch|mcp__critic__publish_patchset",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/bin/critic.mjs\" hook post-tool-use --provider codex",
            "timeout": 5,
            "statusMessage": "Updating Critic"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/bin/critic.mjs\" hook stop --provider codex",
            "timeout": 20,
            "statusMessage": "Checking Critic explanations"
          }
        ]
      }
    ]
  }
}
