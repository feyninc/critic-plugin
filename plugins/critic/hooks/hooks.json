{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/critic.mjs\" hook session-start --provider claude",
            "timeout": 10,
            "statusMessage": "Connecting this task to Critic"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/critic.mjs\" hook user-prompt-submit --provider claude",
            "timeout": 5,
            "statusMessage": "Updating Critic"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|apply_patch|(?:^|__)critic(?:\\.|_)?publish_patchset$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/critic.mjs\" hook post-tool-use --provider claude",
            "timeout": 5,
            "statusMessage": "Updating Critic"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/critic.mjs\" hook stop --provider claude",
            "timeout": 20,
            "statusMessage": "Checking Critic explanations"
          }
        ]
      }
    ]
  }
}
